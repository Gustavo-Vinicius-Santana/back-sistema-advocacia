# Local Docker development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-development-secret
API_SECRET_KEY=
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,restapi_django,host.docker.internal
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
POSTGRES_DB=restapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password

# Production: DEBUG must be false; use HTTPS and explicit public domains.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<secret stored by your cloud provider>
# JWT_SIGNING_KEY=<different secret stored by your cloud provider>
# API_SECRET_KEY=<secret stored by your cloud provider>
# DATABASE_URL=<Render Internal Database URL>
# DJANGO_ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# FRONTEND_URL=https://app.example.com
# JWT_COOKIE_SECURE=true
# JWT_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SECURE=true
# CSRF_COOKIE_SAMESITE=Lax
# CSRF_TRUSTED_ORIGINS=https://app.example.com
